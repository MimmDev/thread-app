WEB_PORT=3000
API_PORT=3001

# Auth.js
AUTH_SECRET=                    # generate with: npx auth secret
AUTH_AUTH0_ID=                  # from: terraform output AUTH_AUTH0_ID
AUTH_AUTH0_SECRET=              # from: Auth0 dashboard → Applications → your app → Settings → Client Secret
AUTH_AUTH0_ISSUER=              # from: terraform output AUTH_AUTH0_ISSUER

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# Anthropic
ANTHROPIC_API_KEY=                # from: console.anthropic.com → API Keys

# OpenAI (embeddings)
OPENAI_API_KEY=                   # from: platform.openai.com → API Keys

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=                # AWS credentials
AWS_SECRET_ACCESS_KEY=            # AWS credentials
AWS_REGION=                       # from: terraform output S3_REGION
S3_BUCKET_NAME=                   # from: terraform output S3_BUCKET_NAME
